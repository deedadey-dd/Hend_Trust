# Django Core Settings
DEBUG=True
SECRET_KEY=django-insecure-replace-me-with-a-secure-key-in-production

# Database
# Example: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://hendaxis_user:hendaxis_pass@localhost:5432/hendaxis_trust_db

# Redis / Celery
# Example: redis://HOST:PORT/DB
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=jwt-secret-replace-me-with-a-secure-key-in-production

# Paystack
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me

# AWS S3 / Object Storage
S3_BUCKET_NAME=hendaxis-trust-bucket
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# SMS Gateway
SMS_GATEWAY_API_KEY=your-sms-api-key

# Payment Gateways (AppsNMobile, ExpressPay, NaloPay)
APPSNMOBILE_CLIENT_ID=your_appsnmobile_client_id
APPSNMOBILE_API_KEY=your_appsnmobile_api_key
APPSNMOBILE_SECRET_KEY=your_appsnmobile_secret_key
APPSNMOBILE_BASE_URL=https://api.anmgw.com/v1

EXPRESSPAY_MERCHANT_ID=your_expresspay_merchant_id
EXPRESSPAY_API_KEY=your_expresspay_api_key

NALOPAY_USERNAME=your_nalopay_username
NALOPAY_PASSWORD=your_nalopay_password
NALOPAY_MERCHANT_ID=your_nalopay_merchant_id

# Courier Tracking APIs (DHL, FedEx, UPS, Speedaf, 17Track Fallback)
DHL_API_KEY=your_dhl_api_key
DHL_API_SECRET=your_dhl_api_secret

FEDEX_CLIENT_ID=your_fedex_client_id
FEDEX_CLIENT_SECRET=your_fedex_client_secret
FEDEX_ACCOUNT_NUMBER=your_fedex_account_number

UPS_CLIENT_ID=your_ups_client_id
UPS_CLIENT_SECRET=your_ups_client_secret

SPEEDAF_APP_CODE=your_speedaf_app_code
SPEEDAF_SECRET_KEY=your_speedaf_secret_key

EMS_API_KEY=your_ems_api_key

17TRACK_API_KEY=your_17track_api_key
COURIER_WEBHOOK_SECRET=secret_courier_key
